ninja_required_version = 1.3
cxx = c++
nvcc = /homes/admin/spack/opt/spack/linux-ivybridge/cuda-11.8.0-gztzlipv5qhdprqkyamrwiafbc6ybqsw/bin/nvcc

cflags = -pthread -B /homes/rcatalini/.conda/envs/fake_gaussian/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /homes/rcatalini/.conda/envs/fake_gaussian/include -fPIC -O2 -isystem /homes/rcatalini/.conda/envs/fake_gaussian/include -fPIC -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include/TH -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include/THC -I/homes/admin/spack/opt/spack/linux-ivybridge/cuda-11.8.0-gztzlipv5qhdprqkyamrwiafbc6ybqsw/include -I/homes/rcatalini/.conda/envs/fake_gaussian/include/python3.10 -c
post_cflags = -g -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include/TH -I/homes/rcatalini/.conda/envs/fake_gaussian/lib/python3.10/site-packages/torch/include/THC -I/homes/admin/spack/opt/spack/linux-ivybridge/cuda-11.8.0-gztzlipv5qhdprqkyamrwiafbc6ybqsw/include -I/homes/rcatalini/.conda/envs/fake_gaussian/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O2 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_37,code=compute_37 -gencode=arch=compute_37,code=sm_37 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





